# Copy to /etc/horserace.env (chmod 600, chown root:root) and fill in.
# The app also accepts SML_-prefixed variants of the API keys.

# --- required API keys ---
GUARDIAN_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=

# --- optional overrides (defaults shown) ---
#SITE_DB_PATH=/opt/horserace/site/data/horserace.db
#SITE_OPENAI_MODEL=gpt-5.6-terra
#SITE_GEMINI_MODEL=gemini-3.5-flash
#SITE_XAI_MODEL=grok-4.5
#SITE_N_QUIZ_QUESTIONS=10
#SITE_MIN_SESSIONS=5
#SITE_AI_WORKERS=12
# Max quiz sessions per UTC day; 0 disables the cap.
#SITE_DAILY_SESSION_CAP=0
